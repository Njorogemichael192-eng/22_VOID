# 22_VOID environment template
# Copy to .env and fill in values. NEVER commit .env. All secrets stay server-side.
# The postgres side is ALSO in docker-compose.yml; keep the two in sync.

# --- Application ---
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Database (local Docker / Postgres 16) ---
# Defaults below match docker-compose.yml, so a fresh `cp` + `docker compose up`
# boots without edits. Change them in BOTH places for a non-default setup.
POSTGRES_USER=void
POSTGRES_PASSWORD=void_dev_password
POSTGRES_DB=22void
DATABASE_URL=postgresql://void:void_dev_password@localhost:5432/22void

# --- Provider keys (SERVER-SIDE ONLY. Never expose to the browser.) ---
# The OddsAPI public feed. Not required for Phase 12+; the raw-payload tests
# inject their own fixtures.
# ODDS_API_KEY=
# ODDS_API_BASE_URL=https://api.the-odds-api.com
# ParlayAPI (Provider B). Generate at your ParlayAPI console; never commit a
# real key. Only resolved when `parlay-api` is listed in WORKER_PROVIDER, so an
# unedited worker that polls odds-api alone never asks for it.
# PARLAY_API_KEY=
# PARLAY_API_BASE_URL=https://parlay-api.com
# PARLAY_API_REGIONS=us
# PARLAY_API_MARKETS=h2h_3_way,totals
# PARLAY_API_SPORT=soccer_epl
# Reference provider (Provider C template): the credential-free adapter from
# docs/ADDING_A_PROVIDER.md. Development only - it serves fixture data and is
# refused in production, exactly like `mock`. Only resolved when `example` is
# listed in WORKER_PROVIDER.
# EXAMPLE_BASE_URL=http://127.0.0.1:4010
# EXAMPLE_REGIONS=uk
# EXAMPLE_MARKETS=h2h,totals
# EXAMPLE_SPORT=soccer_epl
# Comma-separated list; one cycle polls each provider named here and detection
# runs once over the combined prices. `mock` and `example` cannot be combined
# with a real provider. Defaults to mock outside production (refused in production).
# WORKER_PROVIDER=mock

# --- HTTP API auth (apps/web; server-side only, never NEXT_PUBLIC_*) ---
# Read key for the public API + admin key for /admin/* endpoints. Omit to run
# closed (every protected route answers 401).
# API_KEY=<generate a random read key, e.g. openssl rand -hex 32>
# ADMIN_API_KEY=<generate a random admin key, e.g. openssl rand -hex 32>
# DASHBOARD_SOURCE=demo # or unset/ use DATABASE_URL when a live DB is present

# --- Rate limiting (apps/web token buckets; defaults shown) ---
# API_RATE_LIMIT_CAPACITY=60
# API_RATE_LIMIT_REFILL_PER_SECOND=10

# --- Scanner / worker ---
# SCANNER_POLL_INTERVAL_MS=15000
# WORKER_STALENESS_MS=300000
# Coupled on purpose: the worker refuses to start if the poll interval exceeds
# the staleness ceiling, because /healthz reports "stale" once the last completed
# cycle is older than WORKER_STALENESS_MS - so a longer interval than the ceiling
# means the container is unhealthy in the gap between every poll. See
# docs/DEPLOYMENT.md and infra/env.prod.example.
#
# What the live poll actually requests. Cost per poll is
# (number of markets) x (number of regions) credits on the free 500/month plan:
# the defaults below are 2 x 2 = 4 credits/poll = 125 polls/month, i.e. only
# 31 minutes of running at a 15s interval. Raising the interval is the only
# lever; ODDS_API_MARKETS=h2h alone halves it to 2 credits/poll.
# ODDS_API_REGIONS=uk,eu
# ODDS_API_MARKETS=h2h,totals
# ODDS_API_SPORT=soccer_epl
# ODDS_FRESH_SECONDS=15

# --- Health alerting (Phase 19; off unless ALERT_WEBHOOK_URL is set) ---
# The worker evaluates its cycle health and each source's availability and POSTs
# an alert event to this webhook on a transition into DOWN/DEGRADED, and a
# resolution when it recovers. Off unless a URL is set. Must be https in
# production (an alert names which feeds are down).
# ALERT_WEBHOOK_URL=https://hooks.example/services/T000/B000/XXXX
# ALERT_MIN_SEVERITY=warning      # info | warning | critical (below this is tracked, not sent)
# ALERT_RENOTIFY_MS=1800000       # re-notify a still-firing condition this often; 0 = fire once
# ALERT_HYSTERESIS=1              # consecutive unhealthy checks before firing (damps flapping)
# ALERT_CHECK_INTERVAL_MS=30000   # how often the watchdog runs (catches a stalled worker)

# --- Data retention (npm run db:retention; dry run unless --apply) ---
# Days before a row is eligible for deletion. Audit logs are opt-in on purpose:
# pruning the audit trail is a compliance decision, so there is no default.
# RETENTION_RAW_PAYLOAD_DAYS=7
# RETENTION_SCANNER_HEALTH_DAYS=30
# RETENTION_OBSERVATIONS_DAYS=90
# RETENTION_AUDIT_LOGS_DAYS=
# Bounded work per run, so a large backlog is drained over several runs.
# RETENTION_BATCH_SIZE=1000
# RETENTION_MAX_BATCHES=20

# --- Next.js ---
# AUTH_SECRET=<generate with: openssl rand -base64 32>
