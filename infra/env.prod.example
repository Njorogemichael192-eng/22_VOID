# Copy to infra/.env.prod and replace every placeholder before using the proxy or live provider.
# Keep this file out of version control and out of Docker build contexts.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=void
DATABASE_URL=postgresql://postgres:replace-with-strong-postgres-password@db:5432/void
# Hosts the backup sidecar is allowed to target. Must contain the host in
# DATABASE_URL; backup.sh refuses to run otherwise, so a database that moves
# cannot be backed up silently (or, worse, keep backing up the old empty one).
# Comma-separated for a failover pair, e.g. db,db-replica.internal
BACKUP_EXPECTED_HOST=db

# Offsite backups are mandatory. With this true, backup.sh refuses to run at all
# unless an offsite (S3) destination is fully configured, so a same-host-only
# setup cannot pass silently. Total host loss means total data loss otherwise.
BACKUP_REQUIRE_OFFSITE=true
S3_ENABLED=true
# Bucket that actually exists in your account. A placeholder here is rejected:
# the script would otherwise report success while uploading to nothing.
S3_BUCKET=replace-with-your-backup-bucket-name
S3_PREFIX=void/backups
S3_REGION=us-east-1
S3_SSE=AES256
# Leave the key pair EMPTY to use an instance/task role (ECS task role, EKS web
# identity, instance profile) instead of long-lived static credentials. Both
# must be set, or both must be empty.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3-compatible providers (Cloudflare R2, MinIO, Backblaze B2):
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

DASHBOARD_SOURCE=db
API_KEY=replace-with-reader-key-at-least-32-characters
ADMIN_API_KEY=replace-with-admin-key-at-least-32-characters
WEB_PORT=3000
# Address ranges allowed to call /api/v1/ready. Empty = the built-in internal
# defaults (loopback, RFC1918, link-local, IPv6 ULA). Caddy probes readiness
# over the Docker network, so the defaults cover the shipped topology. Set it
# explicitly if your proxy probes from a public address, or to "*" to disable
# the restriction. The web port must stay bound to 127.0.0.1 either way: the
# allowlist reads x-forwarded-for, which a directly-reachable client can forge.
READINESS_ALLOWED_CIDRS=

# The public API's rate limit (web). A token bucket per caller: 120 requests of
# burst, then 2/second sustained. Distinct from the worker's RATE_LIMIT_* below,
# which cap outbound provider polling in the collector - setting one does not
# touch the other. An unparseable value is fatal on purpose: the web refuses to
# start with a rate limit it could not honour, rather than silently falling back
# to a looser default.
API_RATE_LIMIT_CAPACITY=120
API_RATE_LIMIT_REFILL_PER_SECOND=2

WORKER_PROVIDER=odds-api
# The mock provider fabricates odds. Under NODE_ENV=production (which this
# compose file sets) the worker REFUSES to start on it and exits, because with
# DATABASE_URL set below those synthetic prices are written to the real database
# and then served as genuine opportunities - every cycle succeeds and the worker
# reports healthy, so nothing looks wrong.
#
# Set this to true ONLY for a demo or a smoke test that deliberately wants
# production-shaped infrastructure on fake data. It prints a startup banner
# naming every value as invented. Leave empty on any stack anyone reads.
ALLOW_MOCK_PROVIDER_IN_PRODUCTION=
ODDS_API_KEY=replace-with-live-odds-api-key
# Must be https:// in production - the worker refuses http:// here, because every
# request carries the provider key. http:// is accepted only outside production
# (a local test stub). Credentials embedded in the URL, or a credential in its
# query string, are refused everywhere.
ODDS_API_BASE_URL=https://api.the-odds-api.com
# The key is sent as the x-api-key header, not as ?apiKey=, so it is not copied
# into every proxy and CDN access log along the path. Leave this empty. Set it to
# true ONLY if the provider rejects header auth - it puts the key back in the
# URL, where logs and intermediaries can see it.
ODDS_API_AUTH_IN_QUERY=
SCANNER_POLL_INTERVAL_MS=15000
# Worker-side only: caps requests the collector makes to the provider.
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SECOND=5
WORKER_HEALTH_PORT=8081
WORKER_STALENESS_MS=300000

BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_SECONDS=129600
BACKUP_SCHEDULE=0 2 * * *
BACKUP_REQUIRE_OFFHOST=false
S3_ENABLED=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PREFIX=void/backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256
S3_SSE_KMS_KEY_ID=
S3_PATH_STYLE=true

DOMAIN=
ACME_EMAIL=
