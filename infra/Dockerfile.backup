FROM postgres:16-alpine

RUN apk add --no-cache aws-cli coreutils

COPY infra/scripts/backup.sh /usr/local/bin/backup.sh
COPY infra/scripts/backup-entrypoint.sh /usr/local/bin/backup-entrypoint.sh
COPY infra/scripts/backup-health.sh /usr/local/bin/backup-health.sh
COPY infra/scripts/restore.sh /usr/local/bin/restore.sh
RUN chmod +x /usr/local/bin/backup.sh /usr/local/bin/backup-entrypoint.sh /usr/local/bin/backup-health.sh /usr/local/bin/restore.sh

HEALTHCHECK --interval=60s --timeout=10s --start-period=90s --retries=3 CMD ["/usr/local/bin/backup-health.sh"]

ENTRYPOINT ["/usr/local/bin/backup-entrypoint.sh"]
