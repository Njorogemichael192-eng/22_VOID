{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Headers duplicated from apps/web/lib/security/headers.ts.
	#
	# The `header` directive REPLACES any value the upstream already sent, so
	# every entry here overrides the application's copy of the same header. That
	# makes the edge the last word, and it means a value here can silently weaken
	# a stricter policy from proxy.ts. Two of these used to do exactly that:
	# HSTS was set to 31536000 while the app sets 63072000, and
	# Permissions-Policy dropped `interest-cohort=()`. They are now identical to
	# the app's values, and security.test.ts fails if the two ever drift apart.
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Content-Security-Policy is scoped to documents, deliberately NOT site-wide.
	#
	# The app sends a route-aware policy from proxy.ts: a page policy for HTML
	# documents, and a far stricter one for the JSON API
	# (`default-src 'none'; frame-ancestors 'none'; sandbox`) because a JSON
	# response never needs to execute anything. An unconditional site-wide value
	# overwrote that, so every /api/* response went out advertising
	# `script-src 'unsafe-inline'` and, more seriously, no `sandbox` at all.
	#
	# Excluding /api/* lets the app's own policy survive on the routes where it
	# matters. The value below is byte-identical to pageContentSecurityPolicy()
	# in apps/web/lib/security/headers.ts, so overriding the app's page policy is
	# a no-op — enforced by a test rather than left to review.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" {
		not path /api /api/*
	}

	reverse_proxy {$WEB_HOST} {
		health_uri /api/v1/ready
		health_status 200
		health_interval 30s
		health_timeout 5s
	}

	log {
		output stdout
		format console
	}
}
